# %% Cell 4: Merge and Deduplicate Data Sources
def merge_emissions_data(ghgrp_df, carb_df):
   """
   Merge GHGRP and CARB MRR data, preferring CARB for CA-specific detail.
   CARB has lower reporting threshold, so captures more facilities.
   """

   # Standardize sector names across datasets
   sector_mapping = {
       'Electricity Generation': 'Power Generation',
       'Power Plants': 'Power Generation',
       'Petroleum and Natural Gas Systems': 'Oil & Gas',
       'Oil and Gas': 'Oil & Gas',
       'Petroleum Refining': 'Petroleum Refining',
       'Refineries': 'Petroleum Refining',
       'Waste': 'Waste Management',
       'Landfills': 'Waste Management',
       'Cement Production': 'Industrial - Cement',
       'Chemicals': 'Industrial - Chemicals',
       'Metals': 'Industrial - Metals',
   }

   for df in [ghgrp_df, carb_df]:
       if 'sector' in df.columns:
           df['sector_clean'] = df['sector'].map(sector_mapping).fillna(df['sector'])

   # Combine datasets
   # Use CARB as primary (lower threshold, CA-specific)
   # Supplement with GHGRP for any missing facilities

   combined = carb_df.copy() if len(carb_df) > 0 else ghgrp_df.copy()

   if len(ghgrp_df) > 0 and len(carb_df) > 0:
       # Find GHGRP facilities not in CARB
       if 'facility_name' in ghgrp_df.columns and 'facility_name' in carb_df.columns:
           ghgrp_only = ghgrp_df[
               ~ghgrp_df['facility_name'].isin(carb_df['facility_name'])
           ]
           combined = pd.concat([combined, ghgrp_only], ignore_index=True)

   print(f"Combined dataset: {len(combined)} facility-year records")
   return combined

