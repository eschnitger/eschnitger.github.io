# %% Cell 2: Load and Clean GHGRP Data
def clean_ghgrp_data(filepath='data/raw/ghgrp_la_county.csv'):
   """Clean and standardize EPA GHGRP data."""

   df = pd.read_csv(filepath)

   # Standardize column names (EPA changes these occasionally)
   col_mapping = {
       'Facility Id': 'facility_id',
       'FRS Id': 'frs_id',
       'Facility Name': 'facility_name',
       'City': 'city',
       'State': 'state',
       'Zip Code': 'zip_code',
       'Address': 'address',
       'County': 'county',
       'Latitude': 'latitude',
       'Longitude': 'longitude',
       'Industry Type (sectors)': 'sector',
       'Industry Type (subparts)': 'subsector',
       'Reported Year': 'year',
       'Total reported direct emissions': 'total_emissions_mtco2e',
       'CO2 emissions (non-biogenic)': 'co2_nonbio',
       'Methane (CH4) emissions': 'ch4_emissions',
       'Nitrous Oxide (N2O) emissions': 'n2o_emissions',
       'Parent Companies': 'parent_company',
   }

   # Apply mapping for columns that exist
   rename_dict = {k: v for k, v in col_mapping.items() if k in df.columns}
   df = df.rename(columns=rename_dict)

   # If standard columns aren't found, try lowercase matching
   if 'facility_name' not in df.columns:
       df.columns = df.columns.str.lower().str.replace(' ', '_')

   # Ensure numeric emissions columns
   emission_cols = [c for c in df.columns if 'emission' in c.lower() or 'co2' in c.lower()]
   for col in emission_cols:
       df[col] = pd.to_numeric(df[col], errors='coerce')

   # Filter to LA County (if not already filtered)
   if 'county' in df.columns:
       df = df[df['county'].str.contains('Los Angeles', case=False, na=False)]

   # Ensure year is integer
   if 'year' in df.columns:
       df['year'] = pd.to_numeric(df['year'], errors='coerce').astype('Int64')

   print(f"Cleaned GHGRP data: {len(df)} records")
   print(f"Year range: {df['year'].min()} - {df['year'].max()}")
   print(f"Unique facilities: {df['facility_id'].nunique() if 'facility_id' in df.columns else 'N/A'}")

   return df

