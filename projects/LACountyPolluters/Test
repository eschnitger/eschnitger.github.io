def export_for_tableau(analysis_results, facility_trends, sector_trends, county_trend):
   """
   Export clean CSVs optimized for Tableau ingestion.
   """

   output_dir = Path('data/tableau_export')

   # 1. Master facility-year table (primary data source for Tableau)
   # This is the most flexible format for Tableau
   master_cols = [
       'facility_name', 'sector_clean', 'city', 'zip_code',
       'latitude', 'longitude', 'year', 'total_emissions_mtco2e',
       'parent_company'
   ]

   master_df = analysis_results['full_history']['raw']
   available_cols = [c for c in master_cols if c in master_df.columns]
   master_export = master_df[available_cols].copy()

   # Add computed fields useful in Tableau
   if 'year' in master_export.columns:
       max_yr = master_export['year'].max()
       master_export['period_last_year'] = (master_export['year'] == max_yr)
       master_export['period_5yr'] = (master_export['year'] >= max_yr - 4)
       master_export['period_decade'] = (master_export['year'] >= max_yr - 9)

   master_export.to_csv(output_dir / '01_master_facility_emissions.csv', index=False)

   # 2. Facility rankings by period
   for period_name, data in analysis_results.items():
       ranking = data['facility_ranking'].head(50)  # Top 50
       ranking['period'] = data['period']
       ranking.to_csv(
           output_dir / f'02_top_facilities_{period_name}.csv', index=False
       )

   # 3. Sector summary by period
   all_sectors = []
   for period_name, data in analysis_results.items():
       sector_df = data['sector_summary'].copy()
       sector_df['period'] = data['period']
       sector_df['period_name'] = period_name
       all_sectors.append(sector_df)

   pd.concat(all_sectors).to_csv(output_dir / '03_sector_summary.csv', index=False)

   # 4. Time series for trends
   sector_trends.to_csv(output_dir / '04_sector_trends.csv', index=False)
   facility_trends.to_csv(output_dir / '05_facility_trends.csv', index=False)
   county_trend.to_csv(output_dir / '06_county_overall_trend.csv', index=False)

   # 5. Geographic aggregations
   for f in Path('data/processed').glob('*.csv'):
       import shutil
       shutil.copy(f, output_dir / f.name)

   print("\n" + "="*60)
   print("TABLEAU EXPORT COMPLETE")
   print("="*60)
   print(f"\nFiles saved to: {output_dir.absolute()}")
   print("\nExported files:")
   for f in sorted(output_dir.glob('*.csv')):
       size = f.stat().st_size / 1024
       print(f"  {f.name} ({size:.1f} KB)")

