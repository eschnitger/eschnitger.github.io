# %% Cell 7: Prepare Geographic Data for Choropleth
def prepare_choropleth_data(df):
   """
   Aggregate emissions by zip code and city for choropleth mapping.
   """

   # By zip code
   if 'zip_code' in df.columns:
       zip_emissions = (
           df.groupby(['zip_code', 'year'])
           .agg(
               total_emissions=('total_emissions_mtco2e', 'sum'),
               num_facilities=('facility_name', 'nunique'),
           )
           .reset_index()
       )

       # Also create a "latest year" snapshot
       latest_year = df['year'].max()
       zip_latest = zip_emissions[zip_emissions['year'] == latest_year].copy()

       zip_latest.to_csv('data/processed/zip_emissions_latest.csv', index=False)
       zip_emissions.to_csv('data/processed/zip_emissions_all_years.csv', index=False)

       print(f"Zip code data: {len(zip_latest)} zip codes with emissions in {latest_year}")

   # By city
   if 'city' in df.columns:
       city_emissions = (
           df.groupby(['city', 'year'])
           .agg(
               total_emissions=('total_emissions_mtco2e', 'sum'),
               num_facilities=('facility_name', 'nunique'),
           )
           .reset_index()
       )
       city_emissions.to_csv('data/processed/city_emissions_all_years.csv', index=False)
       print(f"City data: {df['city'].nunique()} cities")

   # Point data for facility-level maps
   if 'latitude' in df.columns and 'longitude' in df.columns:
       facility_points = (
           df.groupby(['facility_name', 'latitude', 'longitude', 'sector_clean'])
           .agg(
               latest_emissions=('total_emissions_mtco2e', 'last'),
               avg_emissions=('total_emissions_mtco2e', 'mean'),
               max_emissions=('total_emissions_mtco2e', 'max'),
           )
           .reset_index()
       )
       facility_points.to_csv('data/processed/facility_points.csv', index=False)
       print(f"Facility point data: {len(facility_points)} facilities with coordinates")

prepare_choropleth_data(emissions)

