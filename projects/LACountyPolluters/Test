# %% Cell 5: Create Time-Period Analysis DataFrames
def create_time_period_analysis(df):
   """
   Create analysis dataframes for each time window:
   - Last year (2025)
   - 5 years (2021-2025)
   - Decade (2016-2025)
   - Full history (2010-2025)
   """

   max_year = df['year'].max()

   periods = {
       'last_year': (max_year, max_year),
       '5_year': (max_year - 4, max_year),
       'decade': (max_year - 9, max_year),
       'full_history': (df['year'].min(), max_year),
   }

   results = {}

   for period_name, (start, end) in periods.items():
       period_df = df[(df['year'] >= start) & (df['year'] <= end)].copy()

       # --- Top Facilities ---
       facility_totals = (
           period_df.groupby(['facility_name', 'sector_clean'])
           ['total_emissions_mtco2e']
           .agg(['sum', 'mean', 'count'])
           .reset_index()
           .rename(columns={
               'sum': 'total_emissions',
               'mean': 'avg_annual_emissions',
               'count': 'years_reporting'
           })
           .sort_values('total_emissions', ascending=False)
       )

       # --- Sector Totals ---
       sector_totals = (
           period_df.groupby(['sector_clean', 'year'])
           ['total_emissions_mtco2e']
           .sum()
           .reset_index()
       )

       sector_summary = (
           period_df.groupby('sector_clean')
           ['total_emissions_mtco2e']
           .agg(['sum', 'mean'])
           .reset_index()
           .rename(columns={'sum': 'total_emissions', 'mean': 'avg_annual'})
           .sort_values('total_emissions', ascending=False)
       )

       # --- Geographic (by zip code) ---
       if 'zip_code' in period_df.columns:
           geo_totals = (
               period_df.groupby(['zip_code', 'year'])
               ['total_emissions_mtco2e']
               .sum()
               .reset_index()
           )
       else:
           geo_totals = pd.DataFrame()

       results[period_name] = {
           'raw': period_df,
           'facility_ranking': facility_totals,
           'sector_totals': sector_totals,
           'sector_summary': sector_summary,
           'geo_totals': geo_totals,
           'period': f"{start}-{end}",
       }

       print(f"\n--- {period_name} ({start}-{end}) ---")
       print(f"  Records: {len(period_df)}")
       print(f"  Total emissions: {period_df['total_emissions_mtco2e'].sum():,.0f} MTCO2e")
       print(f"  Top facility: {facility_totals.iloc[0]['facility_name'] if len(facility_totals) > 0 else 'N/A'}")

   return results

analysis = create_time_period_analysis(emissions)

# %% Cell 6: Compute Trends and Year-over-Year Changes
def compute_trends(df):
   """Calculate emission trends, YoY changes, and compound growth rates."""

   # Facility-level trends
   facility_trends = (
       df.groupby(['facility_name', 'year'])
       ['total_emissions_mtco2e']
       .sum()
       .reset_index()
       .sort_values(['facility_name', 'year'])
   )

   facility_trends['yoy_change'] = (
       facility_trends.groupby('facility_name')
       ['total_emissions_mtco2e']
       .pct_change()
   )

   # Sector-level trends
   sector_trends = (
       df.groupby(['sector_clean', 'year'])
       ['total_emissions_mtco2e']
       .sum()
       .reset_index()
       .sort_values(['sector_clean', 'year'])
   )

   sector_trends['yoy_change'] = (
       sector_trends.groupby('sector_clean')
       ['total_emissions_mtco2e']
       .pct_change()
   )

   # Overall county trend
   county_trend = (
       df.groupby('year')
       ['total_emissions_mtco2e']
       .sum()
       .reset_index()
       .sort_values('year')
   )
   county_trend['yoy_change'] = county_trend['total_emissions_mtco2e'].pct_change()

   return facility_trends, sector_trends, county_trend

facility_trends, sector_trends, county_trend = compute_trends(emissions)

